# ── PSRAM / SPIRAM ──────────────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ── Camera (esp32-camera Kconfig) ─────────────────────────────────────────
CONFIG_OV2640_SUPPORT=y
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV3660_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_SCCB_CLK_FREQ=100000
CONFIG_CAMERA_CORE0=y
CONFIG_CAMERA_TASK_STACK_SIZE=2048
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=65536

# ── Brownout ──────────────────────────────────────────────────────────────
# Desabilita brownout detector para evitar reset em loop com fonte USB fraca.
# Para producao, use fonte 5V/2A e reabilite.
CONFIG_ESP_BROWNOUT_DET=n

# ── Task Watchdog ─────────────────────────────────────────────────────────
# O codec JPEG pode levar ~5 s (compress + decompress) em 320×240.
# Aumentar timeout para evitar trigger durante processamento.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
